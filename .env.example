# Local credentials for wrangler (deploys, D1 queries). Never commit .env.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Site (apps/web). Also set in apps/web/wrangler.toml [vars] for Pages.
PUBLIC_APP_URL=https://fomometer.xyz

# Engine settings live in workers/engine/wrangler.toml [vars]:
#   ENGINE_TOP_N, ENGINE_HISTORY_RETENTION_HOURS, ENGINE_BUY_THRESHOLD, ENGINE_SELL_THRESHOLD,
#   ENGINE_CROSS_SECTIONAL_NORM, ENGINE_ADAPTIVE_THRESHOLDS, ENGINE_REGIME_AWARE, ENGINE_WARM_UP_MIN,
#   ENGINE_MIN_LIQUIDITY_USD, ENGINE_BS_RATIO_MIN, ENGINE_BS_RATIO_MAX, ENGINE_PUMP_BLOCK_LO, ENGINE_PUMP_BLOCK_HI.
# Engine secret: STRATEGY_FORMULA_JSON (wrangler secret put, see infra/cloudflare-setup.md).
# Labeler settings live in workers/labeler/wrangler.toml [vars]: LABELER_LOOKBACK_HOURS, LABELER_BATCH_SIZE.
